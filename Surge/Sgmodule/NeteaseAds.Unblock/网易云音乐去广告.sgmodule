#!name=网易云音乐去广告
#!desc=由 ddgksf2013 的 NeteaseAds.conf 转换；需启用 Surge MITM 并信任证书。

[MITM]
hostname = %APPEND% interface*.music.163.com

[Script]
# 加密 eapi 响应：以二进制响应体交给原作者脚本
NeteaseAdsEAPI = type=http-response,pattern=^https?://interface\d?\.music\.163\.com/eapi/(link/home/framework/tab|link/page/discovery/resource/show|link/page/rcmd/resource/show|ios/upgrade/get|search/default/keyword/list|search/rcmd/keyword/get|search/chart/list|search/chart/detail|search/suggest/keyword/get|search/specialkeyword/get|ad/loading/get|ad/loading/current|ad/get|link/position/show/resource|link/scene/show/resource|vip/cashier/tspopup/get|vipnewcenter/app/resource/newaccountpage|side-bar/mini-program/music-service/account|delivery/deliver|delivery/batch-deliver|yunbei/account/entrance/get|creator/musician/reminder/message/get|batch),script-path=https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js,requires-body=true,binary-body-mode=true,max-size=4194304,script-update-interval=86400
# 普通 api 响应：保留文本响应体
NeteaseAdsAPI = type=http-response,pattern=^https?://interface\d?\.music\.163\.com/api/(link/home/framework/tab|link/page/discovery/resource/show|link/page/rcmd/resource/show|ios/upgrade/get|search/default/keyword/list|search/rcmd/keyword/get|search/chart/list|search/chart/detail|search/suggest/keyword/get|search/specialkeyword/get|ad/loading/get|ad/loading/current|ad/get|link/position/show/resource|link/scene/show/resource|vip/cashier/tspopup/get|vipnewcenter/app/resource/newaccountpage|side-bar/mini-program/music-service/account|delivery/deliver|delivery/batch-deliver|yunbei/account/entrance/get|creator/musician/reminder/message/get|batch),script-path=https://gist.githubusercontent.com/ddgksf2013/4f53b7c6083678df25fecc8ff68b52c4/raw/netease.adblock.js,requires-body=true,binary-body-mode=false,max-size=4194304,script-update-interval=86400

[URL Rewrite]
# Surge URL Rewrite 只能拒绝请求；原规则的 reject-200 在这里近似为 reject。
^https?://interface\d?\.music\.163\.com/e?api/content/activity/music/jar/template/list _ reject
^https?://interface\d?\.music\.163\.com/e?api/sp/flow/popup/query _ reject
^https?://interface\d?\.music\.163\.com/e?api/vipmall/couponcfg/get _ reject
^https?://interface\d?\.music\.163\.com/w?eapi/(resource-exposure/)?activity _ reject
^https?://interface\d?\.music\.163\.com/e?api/comment/feed/inserted/resources _ reject
^https?://interface\d?\.music\.163\.com/e?api/resource-exposure/config _ reject
