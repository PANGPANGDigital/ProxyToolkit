#!name=Spotify.Fix
#!desc=iOS 15+；提供账户状态与艺人/专辑展示改写；广告域名规则待实机请求验证。
# Upstream snapshot: app2smile/rules @ df6366a7024e0b3f0aa3510c5b791eea6f3cba89
# 功能: 1.改写账户/播放状态 2.适配歌手/专辑页展示 3.调整随机播放行为
# 广告域名规则暂留空：此前九条只是候选统计/遥测主机，未证实承载广告素材或推广卡片。
# 不拦截 spclient 与共用 CDN 主机，避免影响账户接口、播放及封面/Canvas 等内容资源。

[Header Rewrite]
# if-none-match返回304状态码
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/user-customization-service\/v1\/customize(?:\?.*)?$ header-del if-none-match

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com

[Script]
spotify-json = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=false,script-path=https://raw.githubusercontent.com/PANGPANGDigital/ProxyToolkit/refs/heads/main/Surge/Sgmodule/Spotify/spotify-json.js
spotify-proto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com)(:443)?\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(?:\?.*)?$,requires-body=true,binary-body-mode=true,max-size=1048576,script-path=https://raw.githubusercontent.com/PANGPANGDigital/ProxyToolkit/refs/heads/main/Surge/Sgmodule/Spotify/spotify-proto.js,script-update-interval=0
