#!name=YouTube Enhance
#!desc=为 YouTube & YouTube Music 启用后台播放和画中画（PiP）功能（无去广告纯净版）
#!system=ios

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT-NO-DROP
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT-NO-DROP

[Script]
# 仅拦截与画中画、后台播放相关的核心接口（player / get_watch / account/get_setting）
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(player|get_watch|account\/get_setting)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/PANGPANGDigital/ProxyToolkit/main/Surge/Sgmodule/YouTube.Enhance/youtube.js

[MITM]
# 移除了 *.googlevideo.com，彻底避免视频流握手失败和断流
hostname = %APPEND% youtubei.googleapis.com
