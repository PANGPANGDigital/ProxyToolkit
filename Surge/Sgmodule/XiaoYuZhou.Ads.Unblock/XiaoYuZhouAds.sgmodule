#!name=小宇宙FM去广告
#!desc=基于 ddgksf2013 规则转换；拦截广告相关接口，并移除首页信息流横幅

[MITM]
hostname = %APPEND% api.xiaoyuzhoufm.com

[Script]
小宇宙广告接口 = type=http-request,pattern=^https?://api\.xiaoyuzhoufm\.com/v\d/(?:search/get-express|search/get-preset|category/list-daily-suggestion|flash-screen/list),script-path=XiaoYuZhouAds.js,timeout=10
小宇宙首页信息流 = type=http-response,pattern=^https?://api\.xiaoyuzhoufm\.com/v\d/discovery-feed/list,script-path=XiaoYuZhouAds.js,requires-body=true,max-size=1048576,timeout=10
