#!name=Spotify Enhance
#!desc=Spotify：内置歌词补全与双语翻译（支持官方歌词翻译、网易云 / LRCLIB 匹配与逐字歌词）
#!arguments=启用歌词补全:true,启用歌词翻译:true,翻译目标语言:zh-CN
#!arguments-desc=- 启用歌词补全 / 启用歌词翻译：[true, false]\n- 翻译目标语言：填写翻译语言代码（如 zh-CN、zh-TW、en、ja），默认 zh-CN\n- 已有官方歌词时优先保留；缺失时按歌名、歌手和时长匹配外部歌词。请停用其他 Spotify 歌词模块，避免同一接口冲突。
#!system=ios

[Rule]
# 阻止 Spotify 走 QUIC (HTTP/3)，确保歌词相关请求经由 HTTPS 进入 Surge MITM
AND,((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)),REJECT

[Script]
spotify-scroll = type=http-response,pattern=^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/scrollsita\/v[0-9]+\/scroll\/spotify:[^?#]+(?:\?[^#]*)?$,requires-body=true,binary-body-mode=true,max-size=2097152,timeout=8,script-path=https://raw.githubusercontent.com/PANGPANGDigital/ProxyToolkit/main/Surge/Sgmodule/Spotify.Enhance/spotify-lyrics.js,argument=Lyrics={{{启用歌词补全}}}&Translate={{{启用歌词翻译}}}&TargetLanguage={{{翻译目标语言}}}
spotify-lyrics = type=http-response,pattern=^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/color-lyrics\/v2\/track\/[A-Za-z0-9]{22}(?:\/image\/[^/?#]+)?\/?(?:\?[^#]*)?$,requires-body=true,binary-body-mode=true,max-size=2097152,timeout=20,script-path=https://raw.githubusercontent.com/PANGPANGDigital/ProxyToolkit/main/Surge/Sgmodule/Spotify.Enhance/spotify-lyrics.js,argument=Lyrics={{{启用歌词补全}}}&Translate={{{启用歌词翻译}}}&TargetLanguage={{{翻译目标语言}}}
spotify-lyrics-metadata = type=http-response,pattern=^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:extended-metadata\/v0\/extended-metadata|metadata\/4\/track\/[a-fA-F0-9]{32})(?:\?[^#]*)?$,requires-body=true,binary-body-mode=true,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/PANGPANGDigital/ProxyToolkit/main/Surge/Sgmodule/Spotify.Enhance/spotify-lyrics.js,argument=Lyrics={{{启用歌词补全}}}&Translate={{{启用歌词翻译}}}&TargetLanguage={{{翻译目标语言}}}
spotify-lyrics-playback = type=http-response,pattern=^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/connect-state\/v1\/devices\/[^/?#]+\/?(?:\?[^#]*)?$,requires-body=true,binary-body-mode=true,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/PANGPANGDigital/ProxyToolkit/main/Surge/Sgmodule/Spotify.Enhance/spotify-lyrics.js,argument=Lyrics={{{启用歌词补全}}}&Translate={{{启用歌词翻译}}}&TargetLanguage={{{翻译目标语言}}}

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com, *-spclient.wg.spotify.com
